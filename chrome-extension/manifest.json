{
  "manifest_version": 3,
  "name": "FillSell — Cross-post",
  "version": "0.6.106",
  "description": "Publie automatiquement vos annonces FillSell sur Vinted, Leboncoin, Beebs et eBay.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "cookies",
    "power"
  ],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://*.leboncoin.fr/*",
    "https://*.ebay.fr/*",
    "https://*.ebay.com/*",
    "https://*.beebs.app/*",
    "https://fillsell.app/*",
    "https://tojihnuawsoohlolangc.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://www.opla.co/*",
    "https://www.depop.com/*",
    "https://www.vinted.be/*",
    "https://www.vinted.lu/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.de/*",
    "https://www.vinted.at/*",
    "https://www.vinted.it/*",
    "https://www.vinted.es/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.ie/*",
    "https://www.vinted.fi/*",
    "https://www.vinted.ee/*",
    "https://www.vinted.lv/*",
    "https://www.vinted.lt/*",
    "https://www.vinted.sk/*",
    "https://www.vinted.si/*",
    "https://www.vinted.hr/*",
    "https://www.vinted.gr/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FillSell",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "selectors/*.js"
      ],
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.com/*",
        "https://*.leboncoin.fr/*",
        "https://*.ebay.fr/*",
        "https://*.beebs.app/*",
        "https://www.vinted.be/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.de/*",
        "https://www.vinted.at/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.ie/*",
        "https://www.vinted.fi/*",
        "https://www.vinted.ee/*",
        "https://www.vinted.lv/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.si/*",
        "https://www.vinted.hr/*",
        "https://www.vinted.gr/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fillsell.app/*"
      ],
      "js": [
        "content-scripts/fillsell-auth.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.com/*"
      ],
      "js": [
        "content-scripts/consentement.js",
        "content-scripts/vinted.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.leboncoin.fr/*"
      ],
      "js": [
        "content-scripts/consentement.js",
        "content-scripts/leboncoin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ebay.fr/*",
        "https://*.ebay.com/*"
      ],
      "js": [
        "content-scripts/consentement.js",
        "content-scripts/ebay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.beebs.app/*"
      ],
      "js": [
        "content-scripts/consentement.js",
        "content-scripts/beebs.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
