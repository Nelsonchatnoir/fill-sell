# /srv/fillsell-cloud/.env — sur le SERVEUR seulement (chmod 600), jamais dans le dépôt.
# Écrit par outils/deployer.sh au premier déploiement : clés lues par la CLI
# Supabase sans affichage, clés du coffre et des tickets générées sur place.
SUPABASE_URL=https://tojihnuawsoohlolangc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Le coffre : 32 octets aléatoires en base64 (openssl rand -base64 32). ⛔ Perdue = toutes
# les connexions à refaire ; changée = COFFRE_CLE_VERSION + 1 et reprise du coffre.
COFFRE_CLE=
COFFRE_CLE_VERSION=1
TICKETS_CLE=
SERVEUR_NOM=cloud-1
DOMAINE=cloud.fillsell.app
PORT=8080
# (01/11) steel-browser PUBLIÉ, épinglé : posé par deployer.sh depuis src/navigateur.js (IMAGE_STEEL_ESSAI_0111).
IMAGE_NAVIGATEUR=ghcr.io/steel-dev/steel-browser@sha256:<empreinte>
RESEAU_DOCKER=fillsell-cloud
RESEAU_SOUS_RESEAU=172.31.0.0/24
NAVIGATEURS_MAX=8
MEMOIRE_NAVIGATEUR=1400m
# (01/11) L'essai de 48 h (src/endurance.js) : mesures toutes les 10 min, arrêt au premier blocage. 1 = actif.
ENDURANCE=0
CPU_PAUSE_AU_DESSUS=50
SESSION_MINIMALE_MIN=8
# Test : le compte de Nico SEULEMENT (vide = tous les comptes Cloud actifs).
COMPTES_AUTORISES=f44b5917-bccc-4431-ba41-f40571a2ed18
IPROYAL_API_TOKEN=
IPROYAL_ACHATS_AUTORISES=0
ALERTES_MAIL=0
ALERTES_DESTINATAIRE=support@fillsell.app
ORIGINES=https://fillsell.app,capacitor://localhost,https://localhost
# (04/11 soir, essai GPU) Un second serveur (essai) ne tient PAS le pool : 0 = seul le pare-feu de ses navigateurs suit
# le pool (aucune purge, aucun contrôle, aucune visite, aucune échéance, aucun achat, aucune alerte). 1 = défaut.
ENTRETIEN_POOL=1
# (04/11 soir, essai GPU) Enregistrement de FOND (etat/essais/fond-…jsonl) : requêtes des onglets de travail vers les
# plateformes et DataDome ; _SW=1 y ajoute le service worker de l'extension (⚠ attaché, il ne s'endort plus). 0 = défaut.
ENREGISTREMENT_FOND=0
ENREGISTREMENT_FOND_SW=0
# (04/11 soir, essai GPU) « Me connecter » / « Résoudre » enregistrés pour TOUTES les plateformes (sans : Beebs seul).
ENREGISTREMENT_CONNEXIONS=0
# (04/11 soir, essai GPU) Poste à vraie puce (NAVIGATEUR_GPU=1) : les nœuds de la puce Intel sur CET hôte
# (vide = card0,renderD128 ; carte mère à BMC ASPEED : card1,renderD128).
GPU_PERIPHERIQUES=
