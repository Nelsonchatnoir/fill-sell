{
  "buildCommand": "npm run build:vercel",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/((?!site/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/assets/site/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/app-shell.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/build.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(llms|llms-full)\\.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(login|success|cancel|reset-password)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/desinscription",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/ebay/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/terms", "destination": "/legal", "permanent": true },
    { "source": "/privacy", "destination": "/legal", "permanent": true },
    { "source": "/blog/publier-annonce-plusieurs-plateformes", "destination": "/crosslisting", "permanent": true },
    { "source": "/blog/sell-same-item-vinted-leboncoin-ebay-beebs", "destination": "/blog/vendre-meme-article-vinted-leboncoin-ebay-beebs", "permanent": true },
    { "source": "/blog/how-to-calculate-reselling-profits", "destination": "/blog/comment-calculer-profits-vinted", "permanent": true },
    { "source": "/signup", "destination": "/login?mode=signup", "permanent": true },
    { "source": "/inscription", "destination": "/login?mode=signup", "permanent": true },
    { "source": "/register", "destination": "/login?mode=signup", "permanent": true }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app-shell.html" },
    { "source": "/app/(.*)", "destination": "/app-shell.html" },
    { "source": "/login", "destination": "/app-shell.html" },
    { "source": "/auth", "destination": "/app-shell.html" },
    { "source": "/auth/(.*)", "destination": "/app-shell.html" },
    { "source": "/success", "destination": "/app-shell.html" },
    { "source": "/cancel", "destination": "/app-shell.html" },
    { "source": "/reset-password", "destination": "/app-shell.html" },
    { "source": "/extension", "destination": "/app-shell.html" },
    { "source": "/ebay/(.*)", "destination": "/app-shell.html" },
    { "source": "/desinscription", "destination": "/app-shell.html" },
    { "source": "/legal", "destination": "/app-shell.html" },
    { "source": "/demo/(.*)", "destination": "/app-shell.html" },
    { "source": "/blog", "destination": "/app-shell.html" },
    { "source": "/blog/(.*)", "destination": "/app-shell.html" }
  ]
}
