+  ok(lens && lens.etat === undefined, "fiche à l'état ESTIMÉ (lens) : rien ne baisse", lens);
+  const neuf = C?.contenuAImposer?.(copie("vinted", "publish", "Neuf avec étiquette"), fiche("État neuf", "releve_leboncoin"), t);
