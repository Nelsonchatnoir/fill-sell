diff --git a/libvips/foreign/svgload.c b/libvips/foreign/svgload.c
index e65fa1e1c7..220da4445c 100644
--- a/libvips/foreign/svgload.c
+++ b/libvips/foreign/svgload.c
@@ -83,25 +83,38 @@
 #include <cairo.h>
 #include <librsvg/rsvg.h>
 
-/* Render SVGs with tiles this size. They need to be pretty big to limit
