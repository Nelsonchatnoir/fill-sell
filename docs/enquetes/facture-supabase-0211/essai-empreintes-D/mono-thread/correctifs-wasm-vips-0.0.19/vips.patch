From aac5569c01a3cb67e7f39588b03f61ced054e813 Mon Sep 17 00:00:00 2001
From: Kleis Auke Wolthuizen <github@kleisauke.nl>
Date: Wed, 5 Aug 2020 16:15:59 +0200
Subject: [PATCH 02/14] Remove orc dependency

Upstream-Status: Inappropriate [disable feature]
This patch is just for our convenience.
---
 README.md                          |   3 +-
 libvips/convolution/convi.c        | 510 +----------------------------
 libvips/deprecated/vips7compat.c   |   3 +-
 libvips/include/vips/vips7compat.h |  15 +-
 libvips/iofuncs/vector.cpp         |  29 --
 libvips/morphology/morph.c         | 361 --------------------
 libvips/resample/reducev.cpp       | 501 +---------------------------
 meson.build                        |  20 +-
 meson_options.txt                  |   5 -
 tools/vips.c                       |   2 -
 10 files changed, 24 insertions(+), 1425 deletions(-)

diff --git a/README.md b/README.md
index 3b5fe43ac7..308f1374e2 100644
--- a/README.md
+++ b/README.md
@@ -247,8 +247,7 @@ package pangocairo in `pkg-config --list-all`.
 
 ### highway
 
-If present, libvips will accelerate some operations with SIMD. If not, it
-will look for the orc-0.4 package.
+If available, vips will accelerate some operations with SIMD.
 
 ### matio
 
diff --git a/libvips/convolution/convi.c b/libvips/convolution/convi.c
